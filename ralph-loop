#!/usr/bin/env bash
set -euo pipefail

SLEEP_SECONDS="${RALPH_LOOP_SLEEP_SECONDS:-60}"
AGENT_TIMEOUT="${RALPH_AGENT_TIMEOUT:-45m}"
PROVIDER="${RALPH_PROVIDER:-openai-codex}"
MODEL="${RALPH_MODEL:-gpt-5.3-codex}"
PI_JSON_FORMATTER="${RALPH_PI_JSON_FORMATTER:-./pi-json-human}"
FAILURE_HANDOFF="${RALPH_FAILURE_HANDOFF:-tmp/ralph-loop-last-failure.md}"

cleanup() {
  trap - EXIT INT TERM
  local child_pids
  child_pids="$(jobs -pr || true)"
  if [ -n "$child_pids" ]; then
    kill $child_pids 2>/dev/null || true
    wait 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

sleep_before_retry() {
  echo "$1 Sleeping ${SLEEP_SECONDS}s..."
  sleep "$SLEEP_SECONDS"
}

json_array_len() {
  python3 -c 'import json, sys; data = json.load(sys.stdin); print(len(data) if isinstance(data, list) else 0)'
}

json_array_ids() {
  python3 -c 'import json, sys; data = json.load(sys.stdin); print("\n".join(str(item.get("id", "<unknown>")) for item in data if isinstance(item, dict)))'
}

json_array_ids_with_status() {
  python3 -c 'import json, sys; data = json.load(sys.stdin); print("\n".join("{}\t{}".format(item.get("id", "<unknown>"), item.get("status", "<unknown>")) for item in data if isinstance(item, dict)))'
}

worktree_dirty() {
  [ -n "$(git status --porcelain -- . ':(exclude).beads/issues.jsonl')" ]
}

branch_not_uptodate() {
  local branch_line
  branch_line="$(git status --short --branch | head -n 1)"
  [[ "$branch_line" == *"ahead"* || "$branch_line" == *"behind"* || "$branch_line" == *"diverged"* ]]
}

print_worktree_status() {
  git status --short --branch
}

pi_json_human_enabled() {
  [ "${RALPH_PI_JSON_HUMAN:-1}" != "0" ] && [ -x "$PI_JSON_FORMATTER" ]
}

run_ralph_agent() {
  local timeout_cmd=()
  if command -v timeout >/dev/null 2>&1; then
    timeout_cmd=(timeout --foreground "$AGENT_TIMEOUT")
  fi

  if pi_json_human_enabled; then
    "${timeout_cmd[@]}" \
      pi --mode json --provider "$PROVIDER" --model "$MODEL" @PROMPT.md "follow PROMPT.md" \
      | "$PI_JSON_FORMATTER"
    local statuses=("${PIPESTATUS[@]}")
    return "${statuses[0]}"
  fi

  "${timeout_cmd[@]}" \
    pi --mode json --provider "$PROVIDER" --model "$MODEL" @PROMPT.md "follow PROMPT.md"
}

active_assigned_ralph_work() {
  bd list --label ralph --assignee "AI Agent" --json 2>/dev/null \
    | python3 -c 'import json, sys; data = json.load(sys.stdin); active = [item for item in data if isinstance(item, dict) and item.get("status") in {"open", "in_progress", "blocked"}]; print(json.dumps(active))' \
    || echo "[]"
}

write_failure_handoff() {
  local reason="$1"
  mkdir -p "$(dirname "$FAILURE_HANDOFF")"
  {
    echo "# Ralph Loop Failure Handoff"
    echo
    echo "Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo
    echo "## Reason"
    echo
    echo "$reason"
    echo
    echo "## Git status"
    echo
    echo '```text'
    git status --short --branch || true
    echo '```'
    echo
    echo "## Git diff stat"
    echo
    echo '```text'
    git diff --stat || true
    echo '```'
    echo
    echo "## Active assigned ralph work"
    echo
    echo '```json'
    active_assigned_ralph_work | python3 -m json.tool || true
    echo '```'
  } >"$FAILURE_HANDOFF"
  echo "Wrote failure handoff: $FAILURE_HANDOFF"
}

while :; do
  if worktree_dirty; then
    echo "Worktree is dirty; not launching ralph agent."
    print_worktree_status
    sleep_before_retry "Reconcile or commit the dirty worktree first."
    continue
  fi

  if branch_not_uptodate; then
    echo "Branch is not up to date with its upstream; not launching ralph agent."
    print_worktree_status
    sleep_before_retry "Push/pull/rebase the branch first."
    continue
  fi

  ready=$(bd ready --label ralph --json 2>/dev/null || echo "[]")
  if ! ready_count=$(json_array_len <<<"$ready"); then
    sleep_before_retry "Could not parse ready Beads JSON."
    continue
  fi
  if [ "$ready_count" -eq 0 ]; then
    sleep_before_retry "No ready work."
    continue
  fi

  echo "Launching ralph agent for ${ready_count} ready issue(s)."
  agent_status=0
  run_ralph_agent || agent_status=$?

  if [ "$agent_status" -ne 0 ]; then
    echo "ralph agent exited with status ${agent_status}."
  fi

  if worktree_dirty; then
    echo "ralph agent returned with a dirty worktree; stopping loop to avoid repeated unsafe launches."
    print_worktree_status
    write_failure_handoff "Agent returned with uncommitted worktree changes."
    exit 1
  fi

  if branch_not_uptodate; then
    echo "ralph agent returned with an unpushed/unrebased branch; stopping loop for human review."
    print_worktree_status
    write_failure_handoff "Agent returned with branch ahead, behind, or diverged from upstream."
    exit 1
  fi

  if [ "$agent_status" -ne 0 ]; then
    sleep_before_retry "Backing off after agent failure."
  fi
done
